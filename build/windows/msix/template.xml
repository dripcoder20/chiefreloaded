<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="loop"
        Arguments=""
        InstallLocation="C:\Program Files\DripCoder\Loop">
    </Installer>
    <PackageInformation
        PackageName="Loop"
        PackageDisplayName="Loop"
        PublisherName="CN=DripCoder"
        PublisherDisplayName="DripCoder"
        Version="0.1.0.0"
        PackageDescription="Autonomous PRD builder">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.dripcoder.loop"
                Description="Autonomous PRD builder"
                DisplayName="Loop"
                ExecutableName="loop"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Loop</DisplayName>
            <PublisherDisplayName>DripCoder</PublisherDisplayName>
            <Description>Autonomous PRD builder</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="loop.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
